# Google Gemini (Primary Free Option)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq (Secondary Free/Low-Cost Option)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# DeepSeek (via OpenAI compatible endpoint or direct)
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Mistral AI (fallback / optional)
# Get key: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# OpenRouter (free-tier fallback, access to Qwen3 Coder 480B and other free models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# App Settings
APP_ENV=development
PORT=8000
